{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subtitle-Grabber in Rust",
  "version": "0.2.0",
  "identifier": "com.thevixcho.subtitlegrabber",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Subtitle Grabber",
        "width": 980,
        "height": 680,
        "minWidth": 460,
        "minHeight": 400,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
