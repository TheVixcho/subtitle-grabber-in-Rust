{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Subtitle-Grabber in Rust (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/subtitle-grabber-in-rust",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "cargo: build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Subtitle-Grabber in Rust (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=subtitle-grabber-in-rust",
          "--package=subtitle-grabber-in-rust"
        ],
        "filter": {
          "name": "subtitle-grabber-in-rust",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Unit Tests (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--package=subtitle-grabber-in-rust"
        ],
        "filter": {
          "name": "subtitle_grabber_lib",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
